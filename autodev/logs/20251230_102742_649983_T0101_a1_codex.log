+def sample_poisson(rng: Any, mean: float) -> int:
+    if mean <= 0:
+        return 0
+    if mean > 1000:
+        value = rng.gauss(mean, sqrt(mean))
+        return max(0, int(round(value)))
+    limit = exp(-mean)
+    product = 1.0
+    count = 0
+    while product > limit:
+        product *= rng.random()
+        count += 1
+    return max(0, count - 1)
+
