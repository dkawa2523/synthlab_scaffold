+    merged = deepcopy(base_cfg)
+    merged.update(deepcopy(model_cfg))
+    return merged
+
+
+def _format_size_model_name(name: str) -> str:
+    prefix = "wafer_particles.size_model."
+    return name[len(prefix):] if name.startswith(prefix) else name
+
