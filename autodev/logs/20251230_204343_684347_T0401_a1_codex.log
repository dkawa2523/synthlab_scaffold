+    assert abs(sector["edge_width_mm"] - 2.0) <= 0.4
+
+    assert abs(hotspot["center_x_mm"]) <= 0.35
+    assert abs(hotspot["center_y_mm"]) <= 0.35
+    assert abs(hotspot["sigma_mm"] - 1.0) <= 0.35


