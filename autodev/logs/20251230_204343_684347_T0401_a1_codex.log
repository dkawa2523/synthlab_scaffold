+
+def register_param_estimator(name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+    def _decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+        return _register(_PARAM_ESTIMATOR_REGISTRY, name, func, "param_estimator")
+
+    return _decorator
