+
+def get_param_estimator(name: str) -> Callable[..., Any]:
+    return _get(_PARAM_ESTIMATOR_REGISTRY, name, "param_estimator")
+
+
+def list_param_estimators() -> Iterable[str]:
+    return sorted(_PARAM_ESTIMATOR_REGISTRY.keys())
