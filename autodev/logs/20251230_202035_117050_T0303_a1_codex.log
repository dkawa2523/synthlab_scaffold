+def _resolve_max_examples(audit_cfg: Mapping[str, Any]) -> int:
+    report_cfg = _read_mapping(audit_cfg.get("report"), "wafer_particles.audit.report", required=False)
+    max_examples = int(report_cfg.get("max_examples", 5))
