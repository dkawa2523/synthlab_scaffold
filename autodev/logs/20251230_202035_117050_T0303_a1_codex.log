+    if theta_max < theta_min:
+        raise ValueError("wafer_particles.audit.ranges.theta_rad.max must be >= min")
+
+    return {
+        "r_mm": RangeSpec(min_value=r_min, max_value=r_max),
+        "theta_rad": RangeSpec(min_value=theta_min, max_value=theta_max),
