index 0000000000000000000000000000000000000000..0b7e668c83f86de63d8eb534e491163886a5e9ec
--- /dev/null
+++ b/tests/test_T0303_data_audit_process.py
@@ -0,0 +1,181 @@
+from __future__ import annotations
+
+import csv
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
