+        audit_failed = severity_counts["error"] > 0
+        payload = {
+            "schema_version": str(self.cfg.get("schema_version", SCHEMA_VERSION)),
+            "domain": _domain_name(self.cfg),
+            "input": input_payload(paths),
+            "ranges": {
+                "r_mm": _range_payload(ranges["r_mm"]),
