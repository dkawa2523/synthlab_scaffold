+def _resolve_wafer_particles_cfg(cfg: Mapping[str, Any]) -> dict[str, Any]:
+    wp_cfg = cfg.get("wafer_particles")
+    if not isinstance(wp_cfg, Mapping):
+        raise ValueError("wafer_particles config is required")
+    return dict(wp_cfg)
