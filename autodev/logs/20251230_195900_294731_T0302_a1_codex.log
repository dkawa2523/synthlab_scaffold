+                base_name = str(base_name)
+                base_cfg = patterns.get(base_name)
+                if base_cfg is None:
+                    continue
+                label_defs[base_name] = deepcopy(base_cfg)
+                variants = entry.get("variants") or []
+                if not isinstance(variants, list):
+                    continue
