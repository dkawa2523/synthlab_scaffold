+def _sample_poisson_positive(mean: Any, rng: random.Random, name: str) -> int:
+    if mean is None:
+        raise ValueError(f"{name} is required")
+    mean = float(mean)
+    if mean <= 0:
+        raise ValueError(f"{name} must be positive")
+    for _ in range(10):
