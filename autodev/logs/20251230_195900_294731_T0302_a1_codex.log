+) -> dict[str, Any]:
+    if not expected:
+        return {
+            "status": "skipped",
+            "expected": None,
+            "actual_mean": None,
+            "delta": None,
+            "tolerance": tolerance_ratio,
+            "within_tolerance": None,
+        }
+    mean = observed_stats.get("mean")
+    if mean is None:
+        return {
+            "status": "skipped",
+            "expected": dict(expected),
+            "actual_mean": None,
+            "delta": None,
+            "tolerance": tolerance_ratio,
+            "within_tolerance": None,
+        }
+    expected_mean = expected.get("mean")
