+def _apply_param_ranges(pattern_cfg: dict[str, Any], rng: random.Random) -> None:
+    ranges = pattern_cfg.get("param_ranges")
+    if ranges is None:
+        return
+    if not isinstance(ranges, Mapping):
+        raise ValueError("param_ranges must be a mapping")
+    for key, value in ranges.items():
+        sampled = _sample_range_value(value, rng, f"param_ranges.{key}", base_value=pattern_cfg.get(key))
+        pattern_cfg[str(key)] = sampled
+    pattern_cfg.pop("param_ranges", None)
+
+
+def _sample_range_value(
+    value: Any,
+    rng: random.Random,
+    name: str,
+    *,
+    base_value: Any = None,
+) -> float | int:
+    if value is None:
+        if base_value is None:
+            raise ValueError(f"{name} range value is required")
+        return _coerce_numeric(float(base_value), base_value)
+    if isinstance(value, Mapping):
+        min_value, max_value = _range_bounds(value, name)
+        sampled = rng.uniform(min_value, max_value) if min_value != max_value else min_value
+        return _coerce_numeric(sampled, base_value)
+    if isinstance(value, (list, tuple)):
+        if len(value) != 2:
+            raise ValueError(f"{name} range must have 2 values")
+        min_value = float(value[0])
+        max_value = float(value[1])
+        if min_value > max_value:
+            raise ValueError(f"{name} range must satisfy min<=max")
+        sampled = rng.uniform(min_value, max_value) if min_value != max_value else min_value
+        return _coerce_numeric(sampled, base_value)
+    try:
+        return _coerce_numeric(float(value), base_value)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"{name} must be numeric or a range") from exc
+
+
+def _coerce_numeric(value: float, base_value: Any) -> float | int:
+    if isinstance(base_value, bool):
+        return float(value)
+    if isinstance(base_value, int):
+        return int(round(value))
+    return float(value)
+
+
+def _range_bounds(cfg: Mapping[str, Any], name: str) -> tuple[float, float]:
+    min_value = cfg.get("min", cfg.get("low", cfg.get("start")))
+    max_value = cfg.get("max", cfg.get("high", cfg.get("stop")))
+    if min_value is None or max_value is None:
+        raise ValueError(f"{name} range requires min/max")
+    min_value = float(min_value)
+    max_value = float(max_value)
+    if min_value > max_value:
+        raise ValueError(f"{name} range must satisfy min<=max")
+    return min_value, max_value
+
+
