+) -> dict[str, Any]:
+    if expected_count is None or expected_total <= 0 or actual_total <= 0:
+        return {
+            "status": "skipped",
+            "expected": None,
+            "actual": None,
+            "delta": None,
+            "tolerance": tolerance,
+            "within_tolerance": None,
+        }
