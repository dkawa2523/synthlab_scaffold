+def _apply_param_ranges(pattern_cfg: dict[str, Any], rng: random.Random) -> None:
+    ranges = pattern_cfg.get("param_ranges")
+    if ranges is None:
+        return
+    if not isinstance(ranges, Mapping):
+        raise ValueError("param_ranges must be a mapping")
+    for key, value in ranges.items():
+        sampled = _sample_range_value(value, rng, f"param_ranges.{key}", base_value=pattern_cfg.get(key))
