+        mean = (min_value + max_value) / 2.0
+        return {"type": "range", "mean": mean, "min": min_value, "max": max_value}
+    value = float(dist_cfg)
+    return {"type": "fixed", "mean": value, "min": value, "max": value, "value": value}
+
