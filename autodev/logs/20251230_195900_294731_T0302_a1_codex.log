+        return {
+            "status": "skipped",
+            "expected": dict(expected),
+            "actual_mean": float(mean),
+            "delta": None,
+            "tolerance": tolerance_ratio,
+            "within_tolerance": None,
+        }
+    expected_mean = float(expected_mean)
+    actual_mean = float(mean)
+    delta = actual_mean - expected_mean
+    if expected_mean == 0:
