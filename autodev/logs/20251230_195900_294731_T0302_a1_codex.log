+    delta = actual_ratio - expected_ratio
+    within = abs(delta) <= tolerance
+    return {
+        "status": "checked",
+        "expected": expected_ratio,
+        "actual": actual_ratio,
+        "delta": delta,
+        "tolerance": tolerance,
+        "within_tolerance": within,
