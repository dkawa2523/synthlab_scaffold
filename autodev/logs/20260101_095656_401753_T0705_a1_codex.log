+    return _cdf
+
+
+def _wrap_bounds(cdf_fn, min_um: float | None, max_um: float | None):
+    def _wrapped(x: float) -> float | None:
+        if min_um is not None and x < min_um:
+            return 0.0
+        if max_um is not None and x >= max_um:
+            return 1.0
+        return cdf_fn(x)
