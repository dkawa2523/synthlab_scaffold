+    mix_payload = json.loads(mix_path.read_text(encoding="utf-8"))
+    size_models = mix_payload.get("size_models", {})
+    assert size_models.get("gaussian", {}).get("n_samples") == 2
+    assert size_models.get("lognormal", {}).get("n_samples") == 2

