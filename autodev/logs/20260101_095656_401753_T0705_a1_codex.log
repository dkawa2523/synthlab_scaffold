+    min_count: int,
+) -> tuple[str | None, float | None]:
+    if not enabled or not size_model or not size_params or len(values) < min_count:
+        return None, None
+    model_name = _normalize_size_model_name(size_model)
+    cdf_fn = _build_cdf(model_name, size_params)
+    if cdf_fn is None:
+        return None, None
