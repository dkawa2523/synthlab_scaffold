+    return mix
+
+
+def _write_size_stats_csv(path: Path, rows: list[dict[str, Any]], quantiles: list[float]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fieldnames = [
+        "sample_id",
+        "size_model",
+        "n_particles",
+        "size_mean",
+        "size_std",
+        "size_median",
+        "size_skewness",
+        "size_kurtosis",
+        "size_tail_ratio",
+        "ks_model",
+        "ks_stat",
+    ]
+    fieldnames.extend(_format_quantile_col(q) for q in quantiles)
