+                _validate_positive_bounds(min_value, max_value, name, allow_zero)
+                return
+            if dist == "truncnorm":
+                min_value = float(value.get("min"))
+                max_value = float(value.get("max"))
+                _validate_positive_bounds(min_value, max_value, name, allow_zero)
+                return
+            if dist == "beta":
+                min_value = float(value.get("min", 0.0))
