index 0000000000000000000000000000000000000000..9c8994d59c61bd55ffdc3c4681ac0a8147eab360
--- /dev/null
+++ b/src/synthlab/domains/wafer_particles/generators/size_models/pareto.py
@@ -0,0 +1,44 @@
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from synthlab.framework.registry import register_size_model
+
+
+@register_size_model("wafer_particles.size_model.pareto")
+def assign(
+    cfg: Mapping[str, Any],
+    rng: Any,
+    particles: list[dict[str, Any]],
+) -> list[dict[str, Any]]:
+    alpha = float(cfg.get("alpha", 2.5))
+    xm_um = float(cfg.get("xm_um", 0.1))
+    if alpha <= 0:
+        raise ValueError("alpha must be positive")
+    if xm_um <= 0:
+        raise ValueError("xm_um must be positive")
+    min_um, max_um = _resolve_bounds(cfg)
+
+    for particle in particles:
+        size_um = xm_um * (1.0 + rng.paretovariate(alpha))
+        size_um = _apply_bounds(size_um, min_um, max_um)
+        particle["size_um"] = float(size_um)
+    return particles
+
+
+def _resolve_bounds(cfg: Mapping[str, Any]) -> tuple[float | None, float | None]:
+    min_um = cfg.get("min_um")
+    max_um = cfg.get("max_um")
+    min_value = float(min_um) if min_um is not None else None
+    max_value = float(max_um) if max_um is not None else None
+    if min_value is not None and max_value is not None and max_value < min_value:
+        raise ValueError("max_um must be >= min_um")
+    return min_value, max_value
+
+
+def _apply_bounds(value: float, min_um: float | None, max_um: float | None) -> float:
+    if min_um is not None and value < min_um:
+        return min_um
+    if max_um is not None and value > max_um:
+        return max_um
+    return value
diff --git a/src/synthlab/domains/wafer_particles/generators/size_models/weibull.py b/src/synthlab/domains/wafer_particles/generators/size_models/weibull.py
