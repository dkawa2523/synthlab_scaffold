+
+def _validate_positive_or_spec(value: Any, name: str, *, allow_zero: bool) -> None:
+    if value is None:
+        return
+    if _is_param_spec(value):
+        _validate_param_spec_positive(value, name, allow_zero=allow_zero)
+        return
+    try:
