+            assert isinstance(model_cfg, dict)
+            assert model_cfg.get("type") in {"gaussian"}
+
+    sizes = {float(particle["size_um"]) for particle in particles}
+    assert sizes.issubset({1.0, 10.0})
+    assert sizes == {1.0, 10.0}
