def numpy_rng_from_random(rng: random.Random) -> np.random.Generator:
    state = rng.getstate()
    payload = repr(state).encode("utf-8")
    seed = int(hashlib.sha256(payload).hexdigest()[:16], 16)
    return np.random.default_rng(seed)


