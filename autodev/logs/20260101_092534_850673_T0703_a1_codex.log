def _sample_negative_binomial(rng: random.Random, mean: float, dispersion: float) -> int:
    if mean <= 0:
        return 0
    scale = mean / dispersion
    lambda_value = rng.gammavariate(dispersion, scale)
    return sample_poisson(rng, lambda_value)


