+def register_pattern(name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+    def _decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+        if name in _PATTERN_REGISTRY:
+            raise ValueError(f"pattern already registered: {name}")
+        _PATTERN_REGISTRY[name] = func
+        return func
+
+    return _decorator
+
+
+def get_pattern(name: str) -> Callable[..., Any]:
+    if name not in _PATTERN_REGISTRY:
+        known = ", ".join(sorted(_PATTERN_REGISTRY.keys()))
+        raise KeyError(f"unknown pattern: {name}. known=[{known}]")
+    return _PATTERN_REGISTRY[name]
+
+
+def list_patterns() -> Iterable[str]:
+    return sorted(_PATTERN_REGISTRY.keys())

