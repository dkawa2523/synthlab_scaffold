from __future__ import annotations

from typing import Callable, Dict, Iterable, Type

if False:  # TYPE_CHECKING guard without import overhead
    from .process import BaseProcess  # pragma: no cover


_PROCESS_REGISTRY: Dict[str, \"Type[BaseProcess]\"] = {}


def register_process(name: str) -> Callable[[\"Type[BaseProcess]\"], \"Type[BaseProcess]\"]:
    def _decorator(cls: \"Type[BaseProcess]\") -> \"Type[BaseProcess]\":
        if name in _PROCESS_REGISTRY:
            raise ValueError(f\"process already registered: {name}\")
        _PROCESS_REGISTRY[name] = cls
        return cls

    return _decorator


def get_process(name: str) -> \"Type[BaseProcess]\":
    if name not in _PROCESS_REGISTRY:
        known = \", \".join(sorted(_PROCESS_REGISTRY.keys()))
        raise KeyError(f\"unknown process: {name}. known=[{known}]\")
    return _PROCESS_REGISTRY[name]


def list_processes() -> Iterable[str]:
    return sorted(_PROCESS_REGISTRY.keys())
