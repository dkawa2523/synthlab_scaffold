+        tile_ratio = _resolve_tile_ratio(params, default_ratio=0.9)
+        phase_x = _resolve_phase_norm(params, ctx, pitch_norm, rng, axis="x")
+        phase_y = _resolve_phase_norm(params, ctx, pitch_norm, rng, axis="y")
+        return _sample_grid(
