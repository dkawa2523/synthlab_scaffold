+        if width_norm <= 0:
+            raise ValueError("width must be positive")
+        if spacing_norm < 0:
+            raise ValueError("spacing must be non-negative")
+        if n_lines <= 0:
+            raise ValueError("n_lines must be positive")
+        if n_lines > 1 and spacing_norm <= 0:
