+        return float(cfg["spacing_norm"])
+    if "spacing_mm" in cfg:
+        return mm_to_norm(float(cfg["spacing_mm"]), ctx.wafer_radius_mm)
+    return float(cfg.get("spacing_ratio", 0.12))
+
+
