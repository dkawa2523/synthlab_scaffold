+
+        if arc_radius_norm <= 0:
+            raise ValueError("arc_radius_norm must be positive")
+        if span_rad <= 0:
+            raise ValueError("span_rad must be positive")
+        if width_norm <= 0:
+            raise ValueError("width_norm must be positive")
