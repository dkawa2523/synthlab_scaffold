+            angle_center=angle_center,
+            angle_width=span_rad,
+            radial_width=width_norm,
+        )
+        return [build_particle(r_norm, theta_rad) for r_norm, theta_rad in points]
+
+
+@register_pattern("wafer_particles.pattern.K03_Edge_Arc")
