+
+
+PATTERN_CASES = [
+    ("wafer_particles.pattern.K01_Donut_Hollow", {"r_inner_ratio": 0.4, "r_outer_ratio": 0.9}),
+    (
+        "wafer_particles.pattern.K02_SemiRing_Segment",
+        {"arc_radius_ratio": 0.7, "width_ratio": 0.1, "span_deg": 160.0, "angle_center_deg": 20.0},
