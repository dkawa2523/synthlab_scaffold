+def _validate_dist_spec(spec: Mapping[str, Any], name: str) -> None:
+    dist = str(spec.get("dist") or "").lower()
+    if not dist:
+        raise ValueError(f"{name}.dist is required")
+    if dist == "uniform":
+        _require_range(spec, name, require_positive=False)
