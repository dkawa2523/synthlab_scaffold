+    specs = {
+        "uniform": {"dist": "uniform", "low": 0.1, "high": 0.9},
+        "loguniform": {"dist": "loguniform", "low": 1e-3, "high": 1e-1},
+        "normal": {"dist": "normal", "mean": 0.0, "std": 1.0},
+        "truncnorm": {"dist": "truncnorm", "mean": 0.0, "std": 1.0, "min": -1.0, "max": 1.0},
