+            mean = cfg.get("mean", cfg.get("mu", cfg.get("lambda")))
+            if mean is None:
+                raise ValueError(f"{name}.mean is required")
+            if float(mean) <= 0:
+                raise ValueError(f"{name}.mean must be positive")
+            return
