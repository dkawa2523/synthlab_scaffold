+PATTERN_SCHEMA_VERSION = "wafer_particles.pattern_config.v1"
+LABELING_SCHEMA_VERSION = "wafer_particles.labeling_spec.v1"
+OPTIONAL_PATTERN_PREFIXES = ("O01", "O02")
