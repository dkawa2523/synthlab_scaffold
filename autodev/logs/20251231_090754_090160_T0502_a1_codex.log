+def _read_mapping(value: Any, name: str, *, required: bool = False) -> dict[str, Any]:
+    if value is None:
+        if required:
+            raise ValueError(f"{name} is required")
+        return {}
+    if not isinstance(value, Mapping):
+        raise ValueError(f"{name} must be a mapping")
