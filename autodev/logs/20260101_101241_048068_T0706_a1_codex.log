+    flags_b = [row["is_size_anomaly"] for row in samples_b]
+    types_a = [row["size_anomaly_type"] for row in samples_a]
+    types_b = [row["size_anomaly_type"] for row in samples_b]
+    assert flags_a == flags_b
+    assert types_a == types_b

