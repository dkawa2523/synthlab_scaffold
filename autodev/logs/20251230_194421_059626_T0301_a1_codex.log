+    sample_row = {
+        "sample_id": sample_id,
+        "label": label,
+        "n_particles": n_particles,
+        "pattern_params": json.dumps(pattern_cfg, sort_keys=True, ensure_ascii=True),
+        "seed_offset": seed_offset,
