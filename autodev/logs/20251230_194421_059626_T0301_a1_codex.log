+def _particle_columns_for_streaming(
+    *,
+    include_xy: bool,
+    include_source: bool,
+    include_components: bool,
+) -> list[str]:
+    columns = ["sample_id", "particle_id", "r_mm", "theta_rad", "size_um", "label"]
+    if include_xy:
