from __future__ import annotations

from typing import Any, Callable, Dict, Iterable, TYPE_CHECKING, Type

if TYPE_CHECKING:
    from .process import BaseProcess


_PROCESS_REGISTRY: Dict[str, "Type[BaseProcess]"] = {}
