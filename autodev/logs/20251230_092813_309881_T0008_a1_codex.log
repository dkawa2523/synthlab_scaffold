+        if mean_angle is None:
+            checks.append(_skipped_rule("sector.center_offset", "missing theta mean"))
+        else:
+            offset = _angular_distance(float(mean_angle), expected_center)
+            ok = offset <= float(max_center_offset)
+            checks.append(
