+        return _skipped_rule(name, "missing ratio inputs")
+    ratio = float(value) / float(denom)
+    if mode == "min":
+        ok = ratio >= threshold
+        bound = {"min": threshold}
+    else:
+        ok = ratio <= threshold
+        bound = {"max": threshold}
+    return {"name": name, "ok": ok, "value": ratio, "threshold": bound, "status": "checked"}
