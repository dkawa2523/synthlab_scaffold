+    if value is None:
+        return _skipped_rule(name, "missing coverage")
+    if mode == "min":
+        ok = value >= threshold
+        bound = {"min": threshold}
+    else:
+        ok = value <= threshold
+        bound = {"max": threshold}
+    return {"name": name, "ok": ok, "value": value, "threshold": bound, "status": "checked"}
