+        quantiles = _resolve_quantiles(qc_cfg.get("quantiles"))
+        taxonomy = _parse_taxonomy(self.cfg)
+        wafer_radius_mm = _resolve_wafer_radius_mm(
+            qc_cfg,
+            paths.input_config,
+            particles,
+        )
+
+        label_stats, label_rows, summary = _compute_label_stats(
+            particles,
