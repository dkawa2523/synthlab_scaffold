+            raise ValueError(f"missing split for sample_id: {sample_id}")
+        slot = summary[split]
+        slot["n_samples"] += 1
+        label = str(row.get("label"))
+        label_dist = slot["sample_label_distribution"]
+        label_dist[label] = label_dist.get(label, 0) + 1
