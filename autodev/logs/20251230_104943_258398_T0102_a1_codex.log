+        split = split_map.get(sample_id)
+        if split is None:
+            raise ValueError(f"missing split for sample_id: {sample_id}")
+        rows.append(
+            {
+                "sample_id": sample_id,
+                "split": split,
+                "label": str(row.get("label")),
+                "n_particles": int(row.get("n_particles")),
+            }
+        )
+    return rows
