+
+def _domain_name(cfg: Mapping[str, Any]) -> str:
+    domain = cfg.get("domain")
+    if isinstance(domain, Mapping) and domain.get("name"):
+        return str(domain["name"])
+    if domain:
+        return str(domain)
+    return DOMAIN_NAME


