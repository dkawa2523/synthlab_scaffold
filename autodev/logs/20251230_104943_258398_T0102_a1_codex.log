+
+def _label_distribution(rows: Sequence[Mapping[str, Any]]) -> dict[str, int]:
+    dist: dict[str, int] = {}
+    for row in rows:
+        label = row.get("label")
+        if label is None:
+            continue
+        key = str(label)
+        dist[key] = dist.get(key, 0) + 1
+    return dist
