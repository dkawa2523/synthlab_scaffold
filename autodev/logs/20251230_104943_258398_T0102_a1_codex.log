+    rows: list[dict[str, Any]] = []
+    for row in particles:
+        sample_id = str(row.get("sample_id"))
+        split = split_map.get(sample_id)
+        if split is None:
+            raise ValueError(f"missing split for sample_id: {sample_id}")
+        rows.append(
