+def _write_table(
+    path: Path,
+    rows: Sequence[Mapping[str, Any]],
+    *,
+    fmt: str,
+    csv_cfg: Mapping[str, Any],
+    parquet_cfg: Mapping[str, Any],
+    columns: list[str],
+) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if fmt == "csv":
