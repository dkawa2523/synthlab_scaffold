+            csv_cfg=csv_cfg,
+            parquet_cfg=parquet_cfg,
+            columns=_columns_for_rows(samples, SAMPLES_SCHEMA),
+        )
+        _write_table(
+            writer.run_dir / index_samples_path,
+            sample_index_rows,
+            fmt=fmt,
+            csv_cfg=csv_cfg,
