      - theta mean aligned to sector center
      - r mean near wafer edge
    variants:
      - name: edge_sector_right
        params:
          side: right
        expected_rules:
          - theta coverage concentrated in a sector
          - theta mean aligned to sector center
          - r mean near wafer edge
          - sector center near 0 rad (right)
      - name: edge_sector_left
        params:
          side: left
        expected_rules:
          - theta coverage concentrated in a sector
          - theta mean aligned to sector center
          - r mean near wafer edge
          - sector center near pi rad (left)
      - name: edge_sector_top
        params:
          side: top
        expected_rules:
          - theta coverage concentrated in a sector
          - theta mean aligned to sector center
          - r mean near wafer edge
          - sector center near pi/2 rad (top)
      - name: edge_sector_bottom
        params:
          side: bottom
        expected_rules:
          - theta coverage concentrated in a sector
          - theta mean aligned to sector center
          - r mean near wafer edge
          - sector center near 3pi/2 rad (bottom)

  # line
  - name: scratch
    category: line
    expected_rules:
      - theta coverage is narrow (line-like)
      - points lie close to a fitted line (small perpendicular spread)
    variants:
      - name: scratch_horizontal
        params:
