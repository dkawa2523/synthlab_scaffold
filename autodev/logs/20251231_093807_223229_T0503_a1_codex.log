+    warnings.warn(
+        f"pattern {generator} uses legacy callable interface; update to PatternBase",
+        RuntimeWarning,
+        stacklevel=3,
+    )
+    sample_ctx = {"n_particles": ctx.n_particles, "wafer_radius_mm": ctx.wafer_radius_mm}
