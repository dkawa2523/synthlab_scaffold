+            raise ValueError("particle r_norm out of bounds")
+        if r_norm < 0.0 or r_norm > 1.0:
+            r_norm = min(max(r_norm, 0.0), 1.0)
+
+        particle["r_norm"] = r_norm
+        particle["r_mm"] = norm_to_mm(r_norm, ctx.wafer_radius_mm)
+
