/bin/zsh -lc "python - <<'PY'
from pathlib import Path

root = Path('/Users/kawahito/Desktop/synthlab_scaffold/conf/wafer_particles/patterns')
for path in sorted(root.glob('*.yaml')):
    text = path.read_text(encoding='utf-8').splitlines()
    if any(line.strip().startswith('enabled:') for line in text):
        continue
    insert_idx = None
    for idx, line in enumerate(text):
        if line.strip().startswith('schema_version:') and line.startswith('  '):
            insert_idx = idx + 1
            break
    if insert_idx is None:
        if text:
            insert_idx = 1
        else:
            insert_idx = 0
    text.insert(insert_idx, '  enabled: true')
    path.write_text('\\n'.join(text) + '\\n', encoding='utf-8')
