+
+  # cox
+  - name: cox_lognormal
+    coarse: cox
+    family: cox
+    generator: cox_lognormal
+    description: Cox process with lognormal intensity
+    expected_rules:
+      - grid dispersion above 1 (over-dispersion)
+      - intensity field varies across cells
+
+  # composite
+  - name: composite
+    coarse: composite
+    family: composite
+    generator: composite
+    description: Mixture of components
+    expected_rules:
+      - component mixture ratios are respected
+      - each component retains its expected pattern
+      - label proportions match config
