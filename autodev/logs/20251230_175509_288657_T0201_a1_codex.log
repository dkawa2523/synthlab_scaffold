+version: taxonomy_v2
+domain: wafer_particles
+labels:
+  # ring
+  - name: ring_narrow
+    coarse: ring
+    family: ring
+    generator: ring_narrow
+    description: Narrow ring band
+    expected_rules:
+      - r_std_ratio is small relative to wafer_radius (narrow ring)
+      - theta coverage spans most bins (0..2pi)
+  - name: ring_wide
+    coarse: ring
+    family: ring
+    generator: ring_wide
+    description: Wide ring band
+    expected_rules:
+      - r_std_ratio is larger than ring_narrow but still ring-like
+      - theta coverage spans most bins (0..2pi)
+
+  # sector
+  - name: edge_sector
+    coarse: sector
+    family: edge_sector
+    generator: edge_sector
+    description: Sector at wafer edge
+    expected_rules:
+      - theta coverage concentrated in a sector
+      - theta mean aligned to sector center
+      - r mean near wafer edge
+    variants:
+      - name: edge_sector_right
+        params:
+          side: right
+        description: Edge sector on the right
+        expected_rules:
+          - theta coverage concentrated in a sector
+          - theta mean aligned to sector center
+          - r mean near wafer edge
+          - sector center near 0 rad (right)
+      - name: edge_sector_left
+        params:
+          side: left
+        description: Edge sector on the left
+        expected_rules:
+          - theta coverage concentrated in a sector
+          - theta mean aligned to sector center
+          - r mean near wafer edge
+          - sector center near pi rad (left)
+      - name: edge_sector_top
+        params:
+          side: top
+        description: Edge sector at top
+        expected_rules:
+          - theta coverage concentrated in a sector
+          - theta mean aligned to sector center
+          - r mean near wafer edge
+          - sector center near pi/2 rad (top)
+      - name: edge_sector_bottom
+        params:
+          side: bottom
+        description: Edge sector at bottom
+        expected_rules:
+          - theta coverage concentrated in a sector
+          - theta mean aligned to sector center
+          - r mean near wafer edge
+          - sector center near 3pi/2 rad (bottom)
+
+  # line
+  - name: scratch
+    coarse: line
+    family: scratch
+    generator: scratch
+    description: Linear scratch
+    expected_rules:
+      - theta coverage is narrow (line-like)
+      - points lie close to a fitted line (small perpendicular spread)
+    variants:
+      - name: scratch_horizontal
+        params:
+          angle_category: horizontal
+        description: Horizontal scratch
+        expected_rules:
+          - theta coverage is narrow (line-like)
+          - points lie close to a fitted line (small perpendicular spread)
+          - dominant line angle near 0 or pi (horizontal)
+      - name: scratch_vertical
+        params:
+          angle_category: vertical
+        description: Vertical scratch
+        expected_rules:
+          - theta coverage is narrow (line-like)
+          - points lie close to a fitted line (small perpendicular spread)
+          - dominant line angle near pi/2 (vertical)
+      - name: scratch_diagonal
+        params:
+          angle_category: diagonal
+        description: Diagonal scratch
+        expected_rules:
+          - theta coverage is narrow (line-like)
+          - points lie close to a fitted line (small perpendicular spread)
+          - dominant line angle near pi/4 (diagonal)
+      - name: scratch_diagonal_rev
+        params:
+          angle_category: diagonal_rev
+        description: Diagonal scratch (reverse)
+        expected_rules:
+          - theta coverage is narrow (line-like)
+          - points lie close to a fitted line (small perpendicular spread)
+          - dominant line angle near 3pi/4 (diagonal rev)
+  - name: radial_lines
+    coarse: line
+    family: radial_lines
+    generator: radial_lines
+    description: Multiple radial lines
+    expected_rules:
+      - multiple line angles are present
+      - points cluster along radial lines through the center
+      - theta coverage has multiple narrow modes
+
+  # hotspot
+  - name: hotspot
+    coarse: hotspot
+    family: hotspot
+    generator: hotspot
+    description: Single hotspot
+    expected_rules:
+      - density peak around a center point
+      - density decays with radius from the peak
+    variants:
+      - name: hotspot_center
+        params:
+          mode: center
+        description: Hotspot at center
+        expected_rules:
+          - density peak around a center point
+          - density decays with radius from the peak
+          - peak near wafer center (low r mean ratio)
+      - name: hotspot_edge
+        params:
+          mode: edge
+        description: Hotspot near edge
+        expected_rules:
+          - density peak around a center point
+          - density decays with radius from the peak
+          - peak near wafer edge (high r mean ratio)
+      - name: hotspot_random
+        params:
+          mode: random
+        description: Hotspot at random location
+        expected_rules:
+          - density peak around a center point
+          - density decays with radius from the peak
+          - peak location varies per sample
+
+  # random
+  - name: random_uniform
+    coarse: random
+    family: random
+    generator: random_uniform
+    description: Uniform random distribution
+    expected_rules:
+      - uniform density across wafer area
+      - theta coverage spans most bins
+      - r histogram follows area-proportional profile
+  - name: random_edge_biased
+    coarse: random
+    family: random
+    generator: random_edge_biased
+    description: Random with edge bias
+    expected_rules:
+      - density increases toward edge (high r mean ratio)
+      - theta coverage spans most bins
+
+  # inhom_poisson
+  - name: inhom_poisson
+    coarse: inhom_poisson
+    family: inhom_poisson
+    generator: inhom_poisson
+    description: Inhomogeneous Poisson process
+    expected_rules:
+      - grid dispersion above uniform baseline
+      - grid counts show spatial intensity variation
+      - hist_r and hist_theta show structure
+
+  # cluster
+  - name: cluster_parent_child
+    coarse: cluster
+    family: cluster
+    generator: cluster_parent_child
+    description: Parent-child clustering
+    expected_rules:
+      - nn mean ratio below CSR expectation
+      - grid dispersion above 1 (over-dispersion)
+      - child points cluster around parent centers
+
+  # cox
+  - name: cox_lognormal
+    coarse: cox
+    family: cox
+    generator: cox_lognormal
+    description: Cox process with lognormal intensity
+    expected_rules:
+      - grid dispersion above 1 (over-dispersion)
+      - intensity field varies across cells
+
+  # composite
+  - name: composite
+    coarse: composite
+    family: composite
+    generator: composite
+    description: Mixture of components
+    expected_rules:
+      - component mixture ratios are respected
+      - each component retains its expected pattern
+      - label proportions match config
