python -m synthlab.cli.main process=qc seed=123 run_name=demo_001 wafer_particles.qc.input.run_name=demo_001
python -m synthlab.cli.main process=viz seed=123 run_name=demo_001 wafer_particles.viz.input.run_name=demo_001
