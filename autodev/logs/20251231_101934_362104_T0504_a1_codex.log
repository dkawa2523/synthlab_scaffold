        (
            \"wafer_particles.pattern.C13_Crescent_Internal\",
            {\"outer_radius_ratio\": 0.7, \"inner_radius_ratio\": 0.55, \"offset_ratio\": 0.25},
        ),
        (
            \"wafer_particles.pattern.C14_EdgeSource_Spray\",
