+def _module_info(name: str) -> Dict[str, Any]:
+    try:
+        module = importlib.import_module(name)
+    except Exception as exc:  # pragma: no cover - optional dependency
+        return {
+            "available": False,
+            "error": str(exc),
+        }
+    version = getattr(module, "__version__", None)
+    return {
+        "available": True,
+        "version": version or "unknown",
+    }
