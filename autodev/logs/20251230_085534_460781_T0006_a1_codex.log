+    if name not in _SIZE_MODEL_REGISTRY:
+        known = ", ".join(sorted(_SIZE_MODEL_REGISTRY.keys()))
+        raise KeyError(f"unknown size model: {name}. known=[{known}]")
+    return _SIZE_MODEL_REGISTRY[name]
+
+
+def list_size_models() -> Iterable[str]:
+    return sorted(_SIZE_MODEL_REGISTRY.keys())
