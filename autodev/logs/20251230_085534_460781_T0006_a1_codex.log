+
+
+def register_size_model(name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+    def _decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+        if name in _SIZE_MODEL_REGISTRY:
+            raise ValueError(f"size model already registered: {name}")
+        _SIZE_MODEL_REGISTRY[name] = func
+        return func
+
+    return _decorator
+
+
+def get_size_model(name: str) -> Callable[..., Any]:
+    if name not in _SIZE_MODEL_REGISTRY:
+        known = ", ".join(sorted(_SIZE_MODEL_REGISTRY.keys()))
+        raise KeyError(f"unknown size model: {name}. known=[{known}]")
+    return _SIZE_MODEL_REGISTRY[name]
+
+
+def list_size_models() -> Iterable[str]:
+    return sorted(_SIZE_MODEL_REGISTRY.keys())
