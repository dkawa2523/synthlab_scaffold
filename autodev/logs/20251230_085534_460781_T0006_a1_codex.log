+
+
+def register_size_model(name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+    def _decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+        if name in _SIZE_MODEL_REGISTRY:
+            raise ValueError(f"size model already registered: {name}")
+        _SIZE_MODEL_REGISTRY[name] = func
