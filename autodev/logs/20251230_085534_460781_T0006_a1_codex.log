+    label_key: str = "label",
+) -> list[dict[str, Any]]:
+    if not isinstance(cfg, Mapping):
+        raise ValueError("size model config must be a mapping")
+    if not particles:
+        return particles
+
+    by_label = cfg.get("by_label")
+    if by_label is None:
+        _apply_model(_strip_by_label(cfg), rng, particles)
+        return particles
+    if not isinstance(by_label, Mapping):
