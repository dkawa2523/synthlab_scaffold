+) -> tuple[np.ndarray, list[str], list[str], list[str | None]]:
+    particles_by_sample: dict[str, list[Mapping[str, Any]]] = {}
+    for particle in particles:
+        sample_id = particle.get("sample_id")
+        if sample_id is None:
