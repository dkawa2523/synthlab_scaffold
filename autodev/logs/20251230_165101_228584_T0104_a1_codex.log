+        sample_id = str(sample_id)
+        if sample_ids is not None and sample_id not in sample_ids:
+            continue
+        label = row.get("label")
+        labels.append(str(label) if label is not None else "")
+        ordered_ids.append(sample_id)
+        splits.append(split_map.get(sample_id))
