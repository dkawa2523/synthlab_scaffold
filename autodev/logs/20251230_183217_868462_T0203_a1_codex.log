diff --git a/src/synthlab/domains/wafer_particles/generators/patterns/pp_strauss_repulsive.py b/src/synthlab/domains/wafer_particles/generators/patterns/pp_strauss_repulsive.py
new file mode 100644
index 0000000000000000000000000000000000000000..e797eb90c8232567f5de1e7b7f99884015a743b6
--- /dev/null
+++ b/src/synthlab/domains/wafer_particles/generators/patterns/pp_strauss_repulsive.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from synthlab.framework.registry import register_pattern
+
+from .common import (
+    build_particle,
+    cartesian_to_polar_mm,
+    resolve_sample_ctx,
+    sample_poisson,
+    sample_uniform_disk_xy,
+)
+
+
+@register_pattern("wafer_particles.pattern.pp_strauss_repulsive")
+def generate(
+    cfg: Mapping[str, Any],
+    rng: Any,
+    sample_ctx: Mapping[str, Any] | None = None,
+) -> list[dict[str, float | str]]:
+    ctx = resolve_sample_ctx(cfg, sample_ctx)
+    target_count = _resolve_target_count(cfg, ctx, rng)
+    if target_count <= 0:
+        return []
+
+    min_distance_mm = _resolve_min_distance_mm(cfg, ctx)
+    max_attempts = int(cfg.get("max_attempts", max(200, target_count * 80)))
+    if max_attempts <= 0:
+        raise ValueError("max_attempts must be positive")
+
+    points: list[tuple[float, float]] = []
+    grid: dict[tuple[int, int], list[tuple[float, float]]] = {}
+    origin = -ctx.wafer_radius_mm
+    min_dist_sq = min_distance_mm * min_distance_mm
+    attempts = 0
+
+    while len(points) < target_count and attempts < max_attempts:
+        attempts += 1
+        x_mm, y_mm = sample_uniform_disk_xy(rng, ctx.wafer_radius_mm)
+        if _accept_point(x_mm, y_mm, grid, origin, min_distance_mm, min_dist_sq):
+            points.append((x_mm, y_mm))
+            _store_point(x_mm, y_mm, grid, origin, min_distance_mm)
+
+    particles: list[dict[str, float | str]] = []
+    for x_mm, y_mm in points:
+        r_mm, theta_rad = cartesian_to_polar_mm(x_mm, y_mm)
+        particles.append(build_particle(r_mm, theta_rad))
+    return particles
+
+
+def _resolve_target_count(cfg: Mapping[str, Any], ctx: Any, rng: Any) -> int:
+    if "n_particles" in cfg and cfg.get("n_particles") is not None:
+        count = int(cfg["n_particles"])
+        if count < 0:
+            raise ValueError("n_particles must be non-negative")
+        return count
+    mean_particles = cfg.get("mean_particles")
+    if mean_particles is None:
+        return int(ctx.n_particles)
+    mean_particles = float(mean_particles)
+    if mean_particles < 0:
+        raise ValueError("mean_particles must be non-negative")
+    return sample_poisson(rng, mean_particles)
+
+
+def _resolve_min_distance_mm(cfg: Mapping[str, Any], ctx: Any) -> float:
+    if "min_distance_mm" in cfg and cfg.get("min_distance_mm") is not None:
+        min_distance_mm = float(cfg["min_distance_mm"])
+    else:
+        ratio = float(cfg.get("min_distance_ratio", 0.03))
+        min_distance_mm = ratio * float(ctx.wafer_radius_mm)
+    if min_distance_mm <= 0:
+        raise ValueError("min_distance_mm must be positive")
+    return min_distance_mm
+
+
+def _accept_point(
+    x_mm: float,
+    y_mm: float,
+    grid: Mapping[tuple[int, int], list[tuple[float, float]]],
+    origin: float,
+    cell_size: float,
+    min_dist_sq: float,
+) -> bool:
+    ix, iy = _grid_index(x_mm, y_mm, origin, cell_size)
+    for nx in range(ix - 1, ix + 2):
+        for ny in range(iy - 1, iy + 2):
+            for px_mm, py_mm in grid.get((nx, ny), []):
+                dx = x_mm - px_mm
+                dy = y_mm - py_mm
+                if dx * dx + dy * dy < min_dist_sq:
+                    return False
+    return True
+
+
+def _store_point(
+    x_mm: float,
+    y_mm: float,
+    grid: dict[tuple[int, int], list[tuple[float, float]]],
+    origin: float,
+    cell_size: float,
+) -> None:
+    key = _grid_index(x_mm, y_mm, origin, cell_size)
+    grid.setdefault(key, []).append((x_mm, y_mm))
+
+
+def _grid_index(x_mm: float, y_mm: float, origin: float, cell_size: float) -> tuple[int, int]:
+    ix = int((x_mm - origin) / cell_size)
+    iy = int((y_mm - origin) / cell_size)
+    return ix, iy
