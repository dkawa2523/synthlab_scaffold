+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+import random
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterable, Mapping
+
+import yaml
+
+from synthlab.domains.wafer_particles import (
+    DOMAIN_NAME,
+    SCHEMA_VERSION,
+    polar_to_cartesian_mm,
