diff --git a/src/synthlab/processes/_wafer_particles_io.py b/src/synthlab/processes/_wafer_particles_io.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c407079738c752444cc6242dcde0158cf13e9e9
