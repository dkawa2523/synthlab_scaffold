+        residual_grid,
+        aspect="auto",
+        origin="lower",
+        cmap="coolwarm",
+    )
+    ax.set_title("density residual (best - real)")
+    ax.set_xlabel("theta bin")
+    ax.set_ylabel("r bin")
+    fig.colorbar(im, ax=ax, label="density delta")
