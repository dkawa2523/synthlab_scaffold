+    counts = [int(value) for value in raw]
+    remainder = total - sum(counts)
+    if remainder <= 0:
+        return counts
+    fractions = [value - int(value) for value in raw]
+    order = sorted(range(len(fractions)), key=lambda idx: (-fractions[idx], idx))
+    for idx in range(remainder):
