+def _resolve_background_cfg(cfg: Mapping[str, Any]) -> tuple[bool, int | None, float | None]:
+    enabled = bool(cfg.get("enabled", False))
+    count = cfg.get("count")
+    fraction = cfg.get("fraction")
+    if count is not None:
+        try:
