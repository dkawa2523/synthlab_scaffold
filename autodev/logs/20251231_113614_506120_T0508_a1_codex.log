+                    _fmt(metrics, item.get("score")),
+                    _fmt(metrics, metrics.get("hist_r_l1")),
+                    _fmt(metrics, metrics.get("hist_theta_l1")),
+                    _fmt(metrics, metrics.get("hist_size_l1")),
+                    _fmt(metrics, metrics.get("density_l1")),
+                ]
+            )
+            + " |"
+        )
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
