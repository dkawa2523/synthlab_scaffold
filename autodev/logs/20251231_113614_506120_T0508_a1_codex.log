+                "hist_theta_l1": 1.0,
+                "hist_size_l1": 0.5,
+                "density_l1": 0.0,
+            }
+        },
+    }
+
+
+def _make_cfg(process_name: str, run_name: str, seed: int, wp_cfg: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "run_name": run_name,
+        "seed": seed,
