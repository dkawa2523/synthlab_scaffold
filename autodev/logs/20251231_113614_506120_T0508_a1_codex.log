+def _ensure_comparable(cfg: Mapping[str, Any], real_input: RealInput) -> None:
+    expected_schema = str(cfg.get("schema_version", SCHEMA_VERSION))
+    expected_domain = _domain_name(cfg)
+    input_cfg = real_input.input_config
+    if not input_cfg:
