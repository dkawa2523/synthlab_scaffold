+                "width_mm": width_mm,
+                "param_space": {
+                    "radius_mm": {"dist": "uniform", "min": radius_mm, "max": radius_mm},
+                    "width_mm": {"dist": "uniform", "min": width_mm, "max": width_mm},
+                },
+            },
+            "random_uniform": {
+                "name": "wafer_particles.pattern.random_uniform",
+            },
+            "scratch": {
+                "name": "wafer_particles.pattern.scratch",
