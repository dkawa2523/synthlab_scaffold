+def _derive_seed(base_seed: int, offset: int, component: str) -> int:
+    payload = f"{base_seed}:{offset}:{component}".encode("utf-8")
+    digest = hashlib.sha256(payload).hexdigest()
+    return int(base_seed) + int(digest[:12], 16)
