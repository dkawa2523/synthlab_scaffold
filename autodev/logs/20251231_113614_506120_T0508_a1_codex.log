+        "| rank | label | pattern_id | score | hist_r_l1 | hist_theta_l1 | hist_size_l1 | density_l1 |",
+        "| --- | --- | --- | --- | --- | --- | --- | --- |",
+    ]
+    for idx, item in enumerate(top_patterns, start=1):
