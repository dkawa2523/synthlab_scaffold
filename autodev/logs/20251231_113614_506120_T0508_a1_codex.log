+            "mu_log": 0.0,
+            "sigma_log": 0.1,
+        },
+        "io": {"format": "csv"},
+    }
+
+
+def _coverage_cfg(real_run: Path) -> dict[str, Any]:
+    return {
+        "real_input": {
+            "run_dir": str(real_run),
+        },
+        "pattern_set": ["ring_narrow", "random_uniform", "scratch"],
