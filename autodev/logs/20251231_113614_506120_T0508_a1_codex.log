+
+def _wafer_particles_cfg(radius_mm: float, width_mm: float) -> dict[str, Any]:
+    return {
+        "n_samples": 4,
+        "n_particles": 120,
+        "wafer_radius_mm": 10.0,
+        "sample_id_prefix": "sample",
+        "include_xy": True,
+        "source": "synthetic",
+        "label_selection": {
