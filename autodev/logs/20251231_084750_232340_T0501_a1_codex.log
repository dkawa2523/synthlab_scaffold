+    for layer_name, _mapping in spec.layers.items():
+        suffix = spec.layer_columns[layer_name]
+        entry: dict[str, Any] = {
+            "layer_name": layer_name,
+            "column_suffix": suffix,
+        }
+        particle_col = f"label_{suffix}"
+        if particles:
+            entry["particles"] = {
