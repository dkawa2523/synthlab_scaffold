+def _resolve_labeling_spec_path(labeling_cfg: Mapping[str, Any], repo_root: Path) -> Path:
+    spec_path = labeling_cfg.get("spec_path")
+    if not spec_path:
+        raise ValueError("wafer_particles.labeling.spec_path is required")
