+    find_manifest,
+    paths_from_manifest,
+    read_table,
+)
+
+
+def _wafer_particles_cfg() -> dict[str, Any]:
+    return {
+        "n_samples": 2,
+        "n_particles": 8,
+        "wafer_radius_mm": 10.0,
+        "sample_id_prefix": "sample",
+        "include_xy": True,
+        "source": "synthetic",
+        "label_selection": {
+            "mode": "fixed",
