+            "seed_offset": int(search_cfg.get("seed_offset", 0)),
+            "include_baseline": bool(include_baseline),
+            "warm_start_count": len(warm_start),
+        },
+        "baseline": baseline,
+        "best": {
+            "trial": best_result.trial,
