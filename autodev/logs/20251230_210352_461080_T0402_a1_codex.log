+def _sample_negative_binomial_from_cfg(cfg: Mapping[str, Any], rng: random.Random) -> int:
+    mean = cfg.get("mean")
+    dispersion = cfg.get("dispersion", cfg.get("r", cfg.get("k")))
+    if mean is None or dispersion is None:
