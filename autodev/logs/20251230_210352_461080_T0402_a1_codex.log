+            baseline = {
+                "trial": result.trial,
+                "score": result.score,
+                "metrics": dict(result.metrics),
+            }
+            break
+    return {
+        "schema_version": str(cfg.get("schema_version", SCHEMA_VERSION)),
+        "domain": _domain_name(cfg),
