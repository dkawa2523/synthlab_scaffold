+        return True
+    except Exception:
+        return False
+
+
+def _sanitize_payload(payload: Mapping[str, Any], repo_root: Path) -> dict[str, Any]:
+    sanitized = dict(payload)
+    for key in ["run_dir", "manifest_path", "particles_path", "samples_path"]:
+        if key in sanitized:
