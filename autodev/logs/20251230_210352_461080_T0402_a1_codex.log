+    mean = float(mean)
+    dispersion = float(dispersion)
+    if mean <= 0 or dispersion <= 0:
+        raise ValueError("negative_binomial mean/dispersion must be positive")
+    for _ in range(10):
+        count = _sample_negative_binomial(rng, mean, dispersion)
+        if count > 0:
