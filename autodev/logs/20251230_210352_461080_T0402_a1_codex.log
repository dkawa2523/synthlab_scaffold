+    weights_cfg = score_cfg.get("weights")
+    if not isinstance(weights_cfg, Mapping):
+        weights_cfg = {}
+    defaults = {
+        "r_hist_l1": 1.0,
+        "theta_hist_l1": 1.0,
+        "size_hist_l1": 1.0,
+        "nn_distance_ks": 0.0,
+    }
+    resolved = dict(defaults)
+    for key, value in weights_cfg.items():
+        if key in resolved and value is not None:
+            resolved[key] = float(value)
+    return resolved
