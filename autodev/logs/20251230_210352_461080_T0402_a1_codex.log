+)
+
+import synthlab.domains.wafer_particles.generators  # noqa: F401
+
+
+@dataclass(frozen=True)
+class RealInput:
+    particles: list[dict[str, Any]]
+    samples: list[dict[str, Any]]
+    input_payload: dict[str, Any]
+    input_config: dict[str, Any] | None
