+
+def _sanitize_path(value: Any, repo_root: Path) -> str | None:
+    if not value:
+        return None
+    path = Path(str(value))
+    try:
+        rel = path.resolve().relative_to(repo_root.resolve())
+        return str(rel)
+    except Exception:
