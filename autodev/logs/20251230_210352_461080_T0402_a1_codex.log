+
+    best_cfg = yaml.safe_load(config_path.read_text(encoding="utf-8"))
+    params = best_cfg["wafer_particles"]["patterns"]["ring_narrow"]
+    assert abs(params["radius_mm"] - 6.0) <= 0.6
+    assert abs(params["width_mm"] - 1.2) <= 0.6


