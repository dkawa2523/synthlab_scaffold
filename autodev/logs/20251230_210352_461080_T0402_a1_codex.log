+                    "min": 0.6,
+                    "max": 1.5,
+                },
+            ],
+        },
+        "bins": {
+            "r": {"start": 0.0, "stop": 10.0, "count": 10},
+            "theta": {"start": 0.0, "stop": 6.283185307179586, "count": 12},
+            "size": {"start": 0.0, "stop": 5.0, "count": 10},
+        },
+        "score": {
