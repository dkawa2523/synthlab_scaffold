+    policy_cfg = cfg.get("policy")
+    if isinstance(policy_cfg, Mapping):
+        real_cfg = policy_cfg.get("real_data")
+        if isinstance(real_cfg, Mapping):
+            return _coerce_bool(real_cfg.get("allow_repo_paths"), default=False)
+    return False
