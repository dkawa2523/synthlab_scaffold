+            "include_baseline": bool(include_baseline),
+            "warm_start_count": len(warm_start),
+        },
+        "baseline": baseline,
+        "best": {
+            "trial": best_result.trial,
+            "score": best_result.score,
+            "metrics": dict(best_result.metrics),
+            "params": dict(best_result.params),
+        },
+    }
