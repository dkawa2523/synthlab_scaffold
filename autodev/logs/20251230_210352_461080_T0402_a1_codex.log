+from synthlab.domains.wafer_particles.generators.size_models.common import apply_size_model
+from synthlab.domains.wafer_particles.metrics.qc_metrics import (
+    _compute_hist,
+    _nearest_neighbor_distances,
+    _resolve_edges,
+)
