+def _coerce_param_value(value: Any, spec: ParamSpec) -> Any:
+    dtype = spec.dtype
+    if dtype == "int":
+        return int(round(float(value)))
+    if dtype == "float":
+        return float(value)
+    if isinstance(spec.base_value, int) and not isinstance(spec.base_value, bool):
+        return int(round(float(value)))
+    if isinstance(spec.base_value, float):
+        return float(value)
+    return value
