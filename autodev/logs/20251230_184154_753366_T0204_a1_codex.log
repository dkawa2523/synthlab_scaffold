+            "theta_hist_js": theta_hist_js,
+            "size_ks": size_ks,
+            "size_wasserstein": size_wasserstein,
+            "density_l1": density_l1,
+            "density_l2": density_l2,
+            "nn_distance_ks": nn_distance_ks,
