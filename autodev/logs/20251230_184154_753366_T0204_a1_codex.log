+        color="#C44E52",
+    )
+    axes[1].set_title("theta_rad")
+    axes[1].set_xlabel("theta_rad")
+    axes[1].set_ylabel("density")
+    axes[1].legend(loc="upper right", fontsize="small")
+
+    axes[2].hist(
