+    n = len(a)
+    m = len(b)
+    i = 0
+    j = 0
+    max_diff = 0.0
+    while i < n or j < m:
+        if j >= m:
+            value = a[i]
+        elif i >= n:
+            value = b[j]
+        else:
+            value = a[i] if a[i] <= b[j] else b[j]
+        while i < n and a[i] == value:
+            i += 1
+        while j < m and b[j] == value:
+            j += 1
+        diff = abs((i / n) - (j / m))
+        if diff > max_diff:
+            max_diff = diff
+    return max_diff
