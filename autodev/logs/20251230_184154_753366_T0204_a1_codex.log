+    b = sorted(values_b)
+    n = len(a)
+    m = len(b)
+    weight_a = 1.0 / n
+    weight_b = 1.0 / m
+    i = 0
+    j = 0
+    cdf_a = 0.0
+    cdf_b = 0.0
+    prev = min(a[0], b[0])
+    distance = 0.0
+    while i < n or j < m:
+        if j >= m:
+            value = a[i]
+        elif i >= n:
+            value = b[j]
+        else:
+            value = a[i] if a[i] <= b[j] else b[j]
+        distance += abs(cdf_a - cdf_b) * (value - prev)
+        while i < n and a[i] == value:
+            i += 1
+            cdf_a = i * weight_a
+        while j < m and b[j] == value:
+            j += 1
+            cdf_b = j * weight_b
