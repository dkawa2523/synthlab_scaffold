+    axes[0].hist(r_values_b, bins=r_edges, density=True, alpha=0.6, label="B", color="#C44E52")
+    axes[0].set_title("r_mm")
+    axes[0].set_xlabel("r_mm")
+    axes[0].set_ylabel("density")
+    axes[0].legend(loc="upper right", fontsize="small")
+
+    axes[1].hist(
