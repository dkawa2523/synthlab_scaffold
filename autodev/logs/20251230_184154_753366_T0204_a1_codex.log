+def _write_compare_table(path: Path, summary: Mapping[str, Any]) -> None:
+    rows = [
+        ("r_hist_js", summary.get("r_hist_js")),
+        ("r_hist_kl", summary.get("r_hist_kl")),
+        ("theta_hist_js", summary.get("theta_hist_js")),
