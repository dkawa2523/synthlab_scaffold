+
+def _auto_edges(values: Sequence[float], *, default_count: int) -> list[float]:
+    if not values:
+        return [0.0, 1.0]
+    low = min(values)
+    high = max(values)
+    if low == high:
+        return [low, high + 1.0]
+    step = (high - low) / default_count
+    return [low + step * idx for idx in range(default_count + 1)]
