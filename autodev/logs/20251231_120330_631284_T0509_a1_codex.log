+    wp_cfg = cfg.get("wafer_particles")
+    if not isinstance(wp_cfg, Mapping):
+        return None
+    profile_cfg = wp_cfg.get("profiles")
+    if not isinstance(profile_cfg, Mapping):
+        return None
+    return dict(profile_cfg)
