+        component_type = component.get("type")
+        if component_type:
+            model_name = component_type
+    if not model_name:
+        raise ValueError(f"component {idx} requires model")
+    model_cfg.setdefault("type", model_name)
+    model_cfg.pop("by_label", None)
+    return model_cfg
 
