+    else:
+        cfg_entry = component.get("cfg") or {}
+        if not isinstance(cfg_entry, Mapping):
+            raise ValueError(f"component {idx} cfg must be a mapping")
+        model_cfg = deepcopy(dict(cfg_entry))
