+def _group_by_component(
+    particles: Sequence[Mapping[str, Any]],
+    component_key: str,
+) -> dict[str | None, list[Mapping[str, Any]]]:
+    grouped: dict[str | None, list[Mapping[str, Any]]] = {}
+    for particle in particles:
+        component = particle.get(component_key)
