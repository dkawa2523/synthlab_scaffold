+
+def _resolve_range_value(
+    value: Any,
+    rng: Any,
+    name: str,
+    *,
+    default: float,
+) -> float:
+    if value is None:
+        return float(default)
+    if isinstance(value, Mapping):
+        min_value = value.get("min", value.get("low", value.get("start")))
+        max_value = value.get("max", value.get("high", value.get("stop")))
+        if min_value is None or max_value is None:
+            raise ValueError(f"{name} range requires min/max")
+        min_value = float(min_value)
+        max_value = float(max_value)
+        if min_value > max_value:
+            raise ValueError(f"{name} range must satisfy min<=max")
+        if min_value == max_value:
+            return min_value
+        return float(rng.uniform(min_value, max_value))
+    if isinstance(value, (list, tuple)):
+        if len(value) != 2:
+            raise ValueError(f"{name} range must have 2 values")
+        min_value = float(value[0])
+        max_value = float(value[1])
+        if min_value > max_value:
+            raise ValueError(f"{name} range must satisfy min<=max")
+        if min_value == max_value:
+            return min_value
+        return float(rng.uniform(min_value, max_value))
+    return float(value)
+
+
+def _resolve_float(value: Any, name: str, *, default: float) -> float:
+    if value is None:
+        return float(default)
+    try:
+        return float(value)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"{name} must be numeric") from exc
+
+
+def _apply_transform(
+    particles: list[dict[str, float | str]],
+    transform: Mapping[str, float | bool],
+    rng: Any,
+    *,
+    wafer_radius_mm: float,
+) -> None:
+    rotate = float(transform.get("rotate_theta_rad", 0.0))
+    radial_scale = float(transform.get("radial_scale", 1.0))
+    mirror = bool(transform.get("mirror_theta", False))
+    theta_jitter = float(transform.get("theta_jitter_std", 0.0))
+    r_jitter = float(transform.get("r_jitter_std", 0.0))
+    for particle in particles:
+        r_mm = float(particle["r_mm"]) * radial_scale
+        theta_rad = float(particle["theta_rad"]) + rotate
+        if mirror:
+            theta_rad = -theta_rad
+        if r_jitter > 0.0:
+            r_mm += rng.gauss(0.0, r_jitter)
+        if theta_jitter > 0.0:
+            theta_rad += rng.gauss(0.0, theta_jitter)
+        if r_mm < 0.0:
+            r_mm = 0.0
+        if r_mm > wafer_radius_mm:
+            r_mm = wafer_radius_mm
+        particle["r_mm"] = r_mm
+        particle["theta_rad"] = float(theta_rad) % tau
