+
+def _taxonomy_version(taxonomy_cfg: Mapping[str, Any] | None) -> str:
+    if isinstance(taxonomy_cfg, Mapping):
+        version = taxonomy_cfg.get("version")
+        if version:
+            return str(version)
+    return "unknown"
