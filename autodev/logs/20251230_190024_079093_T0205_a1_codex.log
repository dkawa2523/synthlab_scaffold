+
+def test_export_package_zip(tmp_path: Path) -> None:
+    taxonomy = _load_taxonomy()
+    gen_cfg = _make_cfg("wafer_particles.process.generate", "t0205_gen_zip", seed=33, taxonomy=taxonomy)
