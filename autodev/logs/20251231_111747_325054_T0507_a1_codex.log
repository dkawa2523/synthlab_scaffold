+        "n_particles": 6,
+        "wafer_radius_mm": 10.0,
+        "sample_id_prefix": "sample",
+        "include_xy": True,
+        "source": "synthetic",
+        "labels": taxonomy,
+        "label_selection": {
+            "mode": "fixed",
+            "labels": ["random_uniform"],
