+
+TAXONOMY_PATH = ROOT / "conf" / "wafer_particles" / "labels" / "taxonomy_v1.yaml"
+
+
+def _load_taxonomy() -> dict[str, Any]:
+    data = yaml.safe_load(TAXONOMY_PATH.read_text(encoding="utf-8"))
+    if not isinstance(data, dict):
