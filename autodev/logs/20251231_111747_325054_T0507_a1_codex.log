+    summary: dict[str, Any] = {
+        "primary": dict(label_distribution),
+        "fine_single": _count_fine_labels(samples),
+        "fine_multi": None,
+        "layers": {},
+        "similarity_groups": [],
+    }
+    if _has_column(samples, "labels_fine"):
