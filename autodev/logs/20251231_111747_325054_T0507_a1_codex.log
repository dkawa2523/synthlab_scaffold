+                "seed_offset": 0,
+                "shuffle": True,
+                "ratios": {"train": 0.8, "val": 0.1, "test": 0.1},
+            },
+            "package": {"format": "none"},
+        },
+    }
+
+
+def _make_cfg(
+    process_name: str,
+    run_name: str,
+    seed: int,
+    taxonomy: dict[str, Any],
+    *,
+    spec_path: Path,
+    apply_labeling: bool,
