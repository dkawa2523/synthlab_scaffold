+def _count_values(
+    rows: Sequence[Mapping[str, Any]],
+    column: str,
+    *,
+    empty_label: str | None = None,
+) -> dict[str, int]:
+    counts: dict[str, int] = {}
+    for row in rows:
+        value = row.get(column)
+        if value in (None, ""):
+            if empty_label is None:
+                continue
+            key = empty_label
+        else:
