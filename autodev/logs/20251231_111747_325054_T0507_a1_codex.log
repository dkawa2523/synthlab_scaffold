+def _count_fine_labels(rows: Sequence[Mapping[str, Any]]) -> dict[str, int]:
+    counts: dict[str, int] = {}
+    for row in rows:
+        label = row.get("label_fine")
+        if label in (None, ""):
+            label = row.get("label")
+        key = UNKNOWN_LABEL if label in (None, "") else str(label)
+        counts[key] = counts.get(key, 0) + 1
+    return counts
