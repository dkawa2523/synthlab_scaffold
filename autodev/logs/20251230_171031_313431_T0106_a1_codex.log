+def test_noise_reproducible_with_seed(tmp_path: Path) -> None:
+    noise_cfg = {
+        "jitter": {"enabled": True, "r_std_mm": 0.6, "theta_std_rad": 0.05},
+        "background": {"enabled": True, "fraction": 0.1},
