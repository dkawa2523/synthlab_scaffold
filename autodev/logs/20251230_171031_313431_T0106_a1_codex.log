+            particle["r_mm"] = _clamp(r_mm, 0.0, wafer_radius_mm)
+        if theta_std_rad > 0.0:
+            theta_rad = float(particle["theta_rad"]) + rng.gauss(0.0, theta_std_rad)
+            particle["theta_rad"] = _normalize_theta(theta_rad)
