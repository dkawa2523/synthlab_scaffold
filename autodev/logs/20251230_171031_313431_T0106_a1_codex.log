+    if ratio < 0:
+        raise ValueError("background fraction must be non-negative")
+    if ratio == 0.0 or base_count == 0:
+        return 0
+    return int(math.ceil(base_count * ratio))
+
+
+def generate_background_particles(
+    rng: Any,
+    count: int,
+    *,
+    wafer_radius_mm: float,
+) -> list[dict[str, float]]:
